# Local build overrides for the opizero3-ubuntu build pipeline.
# Copy to docker/local.env (git-ignored) and uncomment what you need.
# docker/run.sh and docker/run-card.sh source docker/local.env when present.

# APT mirror for the U-Boot/TF-A build container (ubuntu archive). Empty = official.
#APT_MIRROR_MAIN="http://mirrors.huaweicloud.com/repository/ubuntu"

# APT mirror for the card-build container AND the chroot apt phase (ubuntu ports).
# Also used as the fallback-then-official mirror by build-card.sh. Empty = official.
#APT_MIRROR_PORTS="http://mirrors.huaweicloud.com/repository/ubuntu-ports"

# Extra docker --dns servers for the card-build container. Empty = docker default.
#DOCKER_DNS="223.5.5.5 119.29.29.29"

# DNS servers written into the image chroot resolv.conf. Empty = copy container resolv.conf.
#CHROOT_DNS="223.5.5.5"

# NTP servers written into the image (systemd-timesyncd drop-in). Empty = distro default.
#NTP_SERVERS="ntp.aliyun.com ntp1.aliyun.com"

# Command tracing (set -x, timestamped PS4) in both container build scripts.
# CI sets DEBUG=1 automatically; uncomment here for local debugging.
#DEBUG=1
